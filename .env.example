# Provedor escolhido para os novos exemplos de roteiro
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Alternativa OpenAI para os exemplos de roteiro (produção acompanhada usa OpenRouter)
OPENAI_API_KEY=
# Informe um modelo disponível na sua conta, compatível com Responses + JSON Schema.
OPENAI_MODEL=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=radar-ia
POLLY_VOICE=Camila
POLLY_ENGINE=generative
LOOKBACK_HOURS=72
HISTORY_DAYS=30
RSS_URLS=https://aws.amazon.com/blogs/machine-learning/feed/,https://github.blog/ai-and-ml/feed/
ALLOWED_DOMAINS=aws.amazon.com,github.blog
KEYWORDS=AI,artificial intelligence,machine learning,LLM,agent,inteligência artificial
OUTPUT_DIR=local-output

# Coleta didática multifuentes (examples/ler_rss.py)
RSS_SOURCES_FILE=config/sources.json
INITIAL_LOOKBACK_DAYS=7
MAX_RECOVERY_DAYS=7

# Primeiro usuário do aplicativo (apenas configuração administrativa local)
APP_LOGIN_EMAIL=

# Actions: configure nas variáveis do repositório, não como credenciais AWS.
# AWS_ROLE_ARN e S3_BUCKET: gerados por examples/configurar_github_aws.py --create
# RADAR_SCHEDULE_ENABLED=false até validar uma execução manual.
