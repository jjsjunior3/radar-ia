{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Radar IA private MVP — HTTPS shell, Cognito login, JWT API and per-user progress. No public signup.",
  "Parameters": {
    "AudioBucket": {
      "Type": "String"
    },
    "AudioPrefix": {
      "Type": "String",
      "Default": "radar-ia"
    },
    "ApiCodeKey": {
      "Type": "String"
    },
    "ReviewerSub": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|[a-f0-9-]{36})",
      "Description": "Cognito sub do responsavel por revisar roteiros; vazio desativa revisao."
    },
    "WorkerCodeKey": {
      "Type": "String"
    },
    "EditorialCodeKey": {
      "Type": "String",
      "Default": ""
    },
    "OpenRouterSecretArn": {
      "Type": "String",
      "Default": ""
    },
    "EditorialScheduleEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "VapidSecretArn": {
      "Type": "String",
      "Default": ""
    },
    "VapidPublicKey": {
      "Type": "String",
      "Default": ""
    },
    "AutomaticPublicationEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Resources": {
    "WebBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RadarIA"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-oac"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "WebHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-headers"
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            },
            "ContentSecurityPolicy": {
              "Override": true,
              "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://*.execute-api.us-east-1.amazonaws.com https://*.auth.us-east-1.amazoncognito.com; media-src 'self' https://*.amazonaws.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
            }
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "DefaultRootObject": "index.html",
          "PriceClass": "PriceClass_100",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "web",
              "DomainName": {
                "Fn::GetAtt": [
                  "WebBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "web",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            },
            "MinTTL": 0,
            "DefaultTTL": 60,
            "MaxTTL": 300,
            "ResponseHeadersPolicyId": {
              "Ref": "WebHeaders"
            }
          }
        }
      }
    },
    "WebBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "WebBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${WebBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "WebBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${WebBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-users"
        },
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 8,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "TemporaryPasswordValidityDays": 7
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "MfaConfiguration": "OPTIONAL",
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "UserPoolDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {
          "Fn::Sub": "radar-ia-${AWS::AccountId}-${AWS::Region}"
        },
        "UserPoolId": {
          "Ref": "UserPool"
        }
      }
    },
    "WebClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "GenerateSecret": false,
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "email"
        ],
        "CallbackURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}/"
          }
        ],
        "LogoutURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}/"
          }
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 60,
        "IdTokenValidity": 60,
        "RefreshTokenValidity": 30,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        }
      }
    },
    "ProgressTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "user_id",
            "AttributeType": "S"
          },
          {
            "AttributeName": "episode_id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "user_id",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "episode_id",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/catalog.json"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/episodes/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/production/editions/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/production/previews/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Query",
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ProgressTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-api:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}"
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": {
                        "Fn::Sub": "${AudioPrefix}/production/editions/*"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/production/editions/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "JobsTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "AudioQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "PushTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "NotificationQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 14
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.12",
        "Handler": "radar_ia.hosted_api.handler",
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Timeout": 20,
        "MemorySize": 256,
        "Code": {
          "S3Bucket": {
            "Ref": "AudioBucket"
          },
          "S3Key": {
            "Ref": "ApiCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "S3_BUCKET": {
              "Ref": "AudioBucket"
            },
            "S3_PREFIX": {
              "Ref": "AudioPrefix"
            },
            "PROGRESS_TABLE": {
              "Ref": "ProgressTable"
            },
            "REVIEWER_SUB": {
              "Ref": "ReviewerSub"
            },
            "JOBS_TABLE": {
              "Ref": "JobsTable"
            },
            "AUDIO_QUEUE_URL": {
              "Ref": "AudioQueue"
            },
            "PUSH_TABLE": {
              "Ref": "PushTable"
            },
            "NOTIFICATION_QUEUE_URL": {
              "Fn::If": [
                "PushConfigured",
                {
                  "Ref": "NotificationQueue"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "VAPID_PUBLIC_KEY": {
              "Ref": "VapidPublicKey"
            },
            "EDITORIAL_SCHEDULE_ENABLED": {
              "Ref": "EditorialScheduleEnabled"
            },
            "AUTOMATIC_PUBLICATION": {
              "Ref": "AutomaticPublicationEnabled"
            }
          }
        }
      },
      "DependsOn": "ApiLogs"
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-http"
        },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Fn::Sub": "https://${Distribution.DomainName}"
            }
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "authorization",
            "content-type",
            "x-radar-client"
          ],
          "MaxAge": 300
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 20000
      }
    },
    "JwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "AuthorizerType": "JWT",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "Name": "CognitoAccessToken",
        "JwtConfiguration": {
          "Audience": [
            {
              "Ref": "WebClient"
            }
          ],
          "Issuer": {
            "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${UserPool}"
          }
        }
      }
    },
    "EpisodesRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /api/episodes",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "AudioRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /api/audio/{episode_id}",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "ProgressRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/progress",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "ApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*/*"
        }
      }
    },
    "ProductionRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /api/production/{date}",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "ApproveScriptRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/production/{date}/approve-script",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "JobsTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "job_id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "job_id",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "expires_at",
          "Enabled": true
        }
      }
    },
    "AudioDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600
      }
    },
    "AudioQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 5400,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "AudioDeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        }
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/production/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/episodes/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/catalog.json"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetBucketOwnershipControls",
                    "s3:GetEncryptionConfiguration"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "polly:SynthesizeSpeech",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "us-east-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "JobsTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "AudioQueue",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "NotificationQueue",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-worker:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "PushTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "NotificationQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Fn::If": [
                    "PushConfigured",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "secretsmanager:GetSecretValue"
                      ],
                      "Resource": {
                        "Ref": "VapidSecretArn"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-worker"
        },
        "RetentionInDays": 14
      }
    },
    "WorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "WorkerLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-worker"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "radar_ia.worker.handler",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Timeout": 900,
        "MemorySize": 512,
        "Code": {
          "S3Bucket": {
            "Ref": "AudioBucket"
          },
          "S3Key": {
            "Ref": "WorkerCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "S3_BUCKET": {
              "Ref": "AudioBucket"
            },
            "S3_PREFIX": {
              "Ref": "AudioPrefix"
            },
            "JOBS_TABLE": {
              "Ref": "JobsTable"
            },
            "REVIEWER_SUB": {
              "Ref": "ReviewerSub"
            },
            "PUSH_TABLE": {
              "Ref": "PushTable"
            },
            "NOTIFICATION_QUEUE_URL": {
              "Fn::If": [
                "PushConfigured",
                {
                  "Ref": "NotificationQueue"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "VAPID_SECRET_ARN": {
              "Fn::If": [
                "PushConfigured",
                {
                  "Ref": "VapidSecretArn"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "AUTOMATIC_PUBLICATION": {
              "Ref": "AutomaticPublicationEnabled"
            }
          }
        }
      }
    },
    "WorkerQueueMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "AudioQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "WorkerFunction"
        },
        "BatchSize": 1,
        "ScalingConfig": {
          "MaximumConcurrency": 2
        },
        "Enabled": true
      }
    },
    "GenerateAudioRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/production/{date}/generate-audio",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "ApproveAudioRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/production/{date}/approve-audio",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "PublishRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/production/{date}/publish",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "PreviewRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /api/production/{date}/preview",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "JobRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /api/jobs/{job_id}",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "EditorialFailureQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "EditorialConfigured",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600
      }
    },
    "EditorialRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "EditorialConfigured",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/production/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/catalog.json"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetBucketOwnershipControls",
                    "s3:GetEncryptionConfiguration"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "JobsTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-editorial:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AudioBucket}/${AudioPrefix}/production/editions/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue",
                    "secretsmanager:DescribeSecret"
                  ],
                  "Resource": {
                    "Ref": "OpenRouterSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "EditorialFailureQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AudioQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "EditorialLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "EditorialConfigured",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-editorial"
        },
        "RetentionInDays": 14
      }
    },
    "EditorialFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "EditorialConfigured",
      "DependsOn": "EditorialLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-editorial"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "radar_ia.scheduled_editorial.handler",
        "Role": {
          "Fn::GetAtt": [
            "EditorialRole",
            "Arn"
          ]
        },
        "Timeout": 900,
        "MemorySize": 512,
        "Code": {
          "S3Bucket": {
            "Ref": "AudioBucket"
          },
          "S3Key": {
            "Ref": "EditorialCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "S3_BUCKET": {
              "Ref": "AudioBucket"
            },
            "S3_PREFIX": {
              "Ref": "AudioPrefix"
            },
            "JOBS_TABLE": {
              "Ref": "JobsTable"
            },
            "REVIEWER_SUB": {
              "Ref": "ReviewerSub"
            },
            "OPENROUTER_SECRET_ARN": {
              "Ref": "OpenRouterSecretArn"
            },
            "OPENROUTER_MODEL": "google/gemini-2.5-flash",
            "AUTOMATIC_PUBLICATION": {
              "Ref": "AutomaticPublicationEnabled"
            },
            "AUDIO_QUEUE_URL": {
              "Ref": "AudioQueue"
            }
          }
        }
      }
    },
    "EditorialAsyncConfig": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Condition": "EditorialConfigured",
      "Properties": {
        "FunctionName": {
          "Ref": "EditorialFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 3600,
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "EditorialFailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "EditorialConfigured",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule-group/default"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-editorial",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "EditorialFunction",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "EditorialFailureQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "EditorialSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Condition": "EditorialConfigured",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-weekday-editorial"
        },
        "Description": "Preparar pauta e roteiro do Radar IA para revisao; nao gera voz nem publica.",
        "ScheduleExpression": "cron(30 8 ? * MON-FRI *)",
        "ScheduleExpressionTimezone": "America/Sao_Paulo",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": {
          "Fn::If": [
            "EditorialEnabled",
            "ENABLED",
            "DISABLED"
          ]
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "EditorialFunction",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": "{\"scheduled_time\":\"<aws.scheduler.scheduled-time>\",\"source\":\"eventbridge\"}",
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 3600,
            "MaximumRetryAttempts": 2
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "EditorialFailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "PushTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "user_id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "user_id",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "NotificationQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 5400,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "AudioDeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        }
      }
    },
    "NotificationQueueMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "NotificationQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "WorkerFunction"
        },
        "BatchSize": 1,
        "ScalingConfig": {
          "MaximumConcurrency": 2
        },
        "Enabled": true
      }
    },
    "PushConfigRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /api/push/config",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "PushSubscribeRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/push/subscribe",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "PushUnsubscribeRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/push/unsubscribe",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    },
    "PushTestRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /api/push/test",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "openid"
        ]
      }
    }
  },
  "Outputs": {
    "WebUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "WebBucket": {
      "Value": {
        "Ref": "WebBucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "UserPoolId": {
      "Value": {
        "Ref": "UserPool"
      }
    },
    "ClientId": {
      "Value": {
        "Ref": "WebClient"
      }
    },
    "AuthDomain": {
      "Value": {
        "Fn::Sub": "https://${UserPoolDomain}.auth.${AWS::Region}.amazoncognito.com"
      }
    },
    "ProgressTable": {
      "Value": {
        "Ref": "ProgressTable"
      }
    },
    "JobsTable": {
      "Value": {
        "Ref": "JobsTable"
      }
    },
    "AudioQueue": {
      "Value": {
        "Ref": "AudioQueue"
      }
    },
    "WorkerFunction": {
      "Value": {
        "Ref": "WorkerFunction"
      }
    },
    "EditorialSchedule": {
      "Condition": "EditorialConfigured",
      "Value": {
        "Ref": "EditorialSchedule"
      }
    },
    "EditorialFunction": {
      "Condition": "EditorialConfigured",
      "Value": {
        "Ref": "EditorialFunction"
      }
    },
    "EditorialFailureQueue": {
      "Condition": "EditorialConfigured",
      "Value": {
        "Ref": "EditorialFailureQueue"
      }
    },
    "PushTable": {
      "Value": {
        "Ref": "PushTable"
      }
    },
    "NotificationQueue": {
      "Value": {
        "Ref": "NotificationQueue"
      }
    }
  },
  "Conditions": {
    "EditorialConfigured": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "EditorialCodeKey"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "OpenRouterSecretArn"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "EditorialEnabled": {
      "Fn::And": [
        {
          "Condition": "EditorialConfigured"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EditorialScheduleEnabled"
            },
            "true"
          ]
        }
      ]
    },
    "PushConfigured": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "VapidSecretArn"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "VapidPublicKey"
                },
                ""
              ]
            }
          ]
        }
      ]
    }
  }
}
